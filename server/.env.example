# Production API configuration. Replace every placeholder in your hosting provider's secret manager.
APP_ENV=production
LOG_LEVEL=INFO
MONGODB_URI=mongodb+srv://<database-user>:<database-password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DATABASE=evelyn-hart-portfolio

# Generate three different, stable, random secrets (at least 32 characters each).
# Never reuse a secret or rotate DATA_ENCRYPTION_KEY / EMAIL_INDEX_SECRET without migration.
JWT_SECRET=replace-with-a-unique-random-secret-at-least-32-characters
JWT_EXPIRES_IN=8h
DATA_ENCRYPTION_KEY=replace-with-a-separate-stable-random-secret
EMAIL_INDEX_SECRET=replace-with-another-separate-stable-random-secret

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters

# Exact HTTPS origins only; comma-separated origins may include multiple frontends.
FRONTEND_URL=https://www.example.com
PUBLIC_WEBSITE_URL=https://www.example.com
API_PUBLIC_URL=https://api.example.com
API_ALLOWED_ORIGINS=https://www.example.com,https://example.com
SESSION_COOKIE_SAMESITE=strict

# Use a dedicated SMTP relay; never use Gmail credentials.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_FROM=
SMTP_USERNAME=
SMTP_PASSWORD=

# Nepal payment providers. Keep test credentials separate from live credentials.
ESEWA_MODE=test
ESEWA_TEST_PRODUCT_CODE=
ESEWA_TEST_SECRET_KEY=
ESEWA_LIVE_PRODUCT_CODE=
ESEWA_LIVE_SECRET_KEY=
KHALTI_MODE=test
KHALTI_TEST_SECRET_KEY=
KHALTI_LIVE_SECRET_KEY=
