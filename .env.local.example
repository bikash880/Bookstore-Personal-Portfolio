# Leave empty to proxy /api requests through Next.js. For separate API hosting,
# set this to the public HTTPS API origin before running next build.
NEXT_PUBLIC_API_URL=

# Backend origin used by the Next.js /api proxy and server-side metadata requests.
# For local development, this is the API started by `npm run api`.
API_SERVER_URL=http://127.0.0.1:4000
